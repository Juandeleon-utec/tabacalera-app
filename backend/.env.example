# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tabacalera_user
DB_PASS=tu_password_seguro
DB_NAME=tabacalera_db

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Servidor
PORT=3000
NODE_ENV=development

# IPs permitidas para endpoint /api/sync (separadas por coma)
# Ejemplo: red interna 192.168.1.0/24
ALLOWED_IPS=127.0.0.1,192.168.1.0/24

# Credenciales del superadmin de la app (para referencia)
ADMIN_PASSWORD_HASH=$2b$10$HASH_GENERADO_CON_BCRYPT
