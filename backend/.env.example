# Base de datos MySQL
DB_HOST=192.168.4.202
DB_PORT=3306
DB_USER=root
DB_PASS=MontepazRivera
DB_NAME=tabacalera

# JWT
JWT_SECRET=MontepazJWT2027Tabacalera
JWT_EXPIRES_IN=14d

# Servidor
PORT=3000
NODE_ENV=production

# IPs permitidas para endpoint /api/sync (separadas por coma)
# Ejemplo: red interna 192.168.1.0/24
ALLOWED_IPS=127.0.0.1,192.168.4.0/24,192.168.5.0/24,192.168.0.0/24

# Panel web de administración (/admin)
# ADMIN_PASSWORD_HASH es obligatorio: sin él el login del panel responde 500.
# Generar: node -e "console.log(require('bcryptjs').hashSync('Admin2026!', 10))"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=$2b$10$HASH_GENERADO_CON_BCRYPT
SESSION_SECRET=una_clave_secreta_larga_y_aleatoria
