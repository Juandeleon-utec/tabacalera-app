{
  "expo": {
    "name": "Tabacalera Montepaz",
    "slug": "tabacalera-app",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Montepaz_Blanco.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B5333"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.montepaz.tabacalera",
      "infoPlist": {
        "NSCameraUsageDescription": "Se necesita la cámara para escanear los códigos QR de los fardos.",
        "NSLocationWhenInUseUsageDescription": "Se usa la ubicación GPS para registrar el lugar de compra."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/montepaz_Icono.png",
        "backgroundColor": "#6B5333"
      },
      "package": "com.montepaz.tabacalera",
      "versionCode": 7,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Se necesita la cámara para escanear códigos QR de fardos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Se usa la ubicación para registrar dónde se realizó la compra."
        }
      ],
      "./plugins/withImpresionTermica",
      "./plugins/withNetworkSecurityConfig"
    ],
   "extra": {
      "eas": {
        "projectId": "fc276883-7390-4d39-971b-0a8307eb2ef3"
      }
    },
    "owner": "juanpdeleon"
  }
}
